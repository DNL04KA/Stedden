# ─── Stedden backend environment ─────────────────────────────────────────────
# Copy to `.env` and fill in. Never commit `.env`. Synthetic/demo data only for
# the MVP — no PHI, no real patients (see README, Compliance).

# --- App ---
APP_ENV=local                      # local | production
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:8080   # public WSS/HTTPS origin Twilio calls back to

# --- Database (Supabase Postgres) ---
# Use the Supabase "connection pooling" URI for the API; direct URI for migrations.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stedden

# --- OpenAI (the Brain) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1               # text model for the Responses API turn
OPENAI_TIMEOUT_SECONDS=8

# --- Twilio (telephony + ConversationRelay) ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# STT/TTS are configured on the ConversationRelay TwiML, not here:
CONVERSATION_RELAY_TTS_PROVIDER=elevenlabs
CONVERSATION_RELAY_VOICE=...        # ElevenLabs voice id
CONVERSATION_RELAY_STT_PROVIDER=deepgram

# --- Resend (lead notification email) ---
RESEND_API_KEY=re_...
LEAD_EMAIL_FROM=receptionist@stedden.ai
LEAD_EMAIL_REPLY_TO=

# --- Supabase Storage (call audio; wired later) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=call-audio

# --- Admin protection (single shared token; no auth system) ---
ADMIN_API_TOKEN=change-me
